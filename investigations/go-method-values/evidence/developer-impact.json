      "question": "Does eager HIMPORT master fan-out run callbacks concurrently, wait for completion, and return an error?",
      "source": "himport_cluster.go",
      "target": "osscluster.go",
      "owner": "ClusterClient",
      "symbol": "ForEachMaster",
      "definition_lines": [
